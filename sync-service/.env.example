SUPABASE_URL=https://your-project-ref.supabase.co
# Must be the service-role key from the same Supabase project as SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Required when AI spam analysis is enabled.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Passenger supplies PORT automatically; use this default for direct Node runs.
PORT=8080
# Optional: override default 90-day backfill window
BACKFILL_DAYS=90
# Optional: polling interval in ms (default 30000 = 30s)
POLL_INTERVAL_MS=30000
# Optional: maximum outbound queue send attempts (default 5)
OUTBOUND_MAX_ATTEMPTS=5
